<Window x:Class="PandaMultimediaDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PandaMultimediaDownloader.Localization"
        xmlns:vm="clr-namespace:PandaMultimediaDownloader.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding [AppTitle], Source={x:Static loc:Loc.Instance}}"
        Width="820" Height="640" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#33FFFFFF" Margin="0,0,14,0">
                    <TextBlock Text="🐼" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [AppTitle], Source={x:Static loc:Loc.Instance}}"
                               FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding [Subtitle], Source={x:Static loc:Loc.Instance}}"
                               FontSize="12" Foreground="#CCFFFFFF" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [LanguageLabel], Source={x:Static loc:Loc.Instance}}"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" Width="120" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Input card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}"
                                   Text="{Binding [UrlLabel], Source={x:Static loc:Loc.Instance}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}" />
                                <TextBlock Text="{Binding [UrlPlaceholder], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="14" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding PasteCommand}"
                                    Content="{Binding [Paste], Source={x:Static loc:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Text="{Binding [FormatLabel], Source={x:Static loc:Loc.Instance}}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsMp4}" IsEnabled="{Binding IsIdle}"
                                              Content="{Binding [Mp4], Source={x:Static loc:Loc.Instance}}" />
                                    <CheckBox IsChecked="{Binding IsMp3}" IsEnabled="{Binding IsIdle}" Margin="10,0,0,0"
                                              Content="{Binding [Mp3], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource LabelText}"
                                           Text="{Binding [CookiesLabel], Source={x:Static loc:Loc.Instance}}" />
                                <ComboBox ItemsSource="{Binding Browsers}" SelectedItem="{Binding CookiesBrowser, Mode=TwoWay}"
                                          IsEnabled="{Binding IsIdle}" Width="130" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="">
                                                                <Setter Property="Text"
                                                                        Value="{Binding [CookiesNone], Source={x:Static loc:Loc.Instance}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}"
                                    IsDefault="True" MinWidth="150"
                                    Content="{Binding [Download], Source={x:Static loc:Loc.Instance}}" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Margin="10,0,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                    Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress card -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate}" />
                    </StackPanel>
                </Border>

                <!-- Log card -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Margin="0"
                                       Text="{Binding [LogLabel], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="10,4"
                                    Command="{Binding ClearLogCommand}"
                                    Content="{Binding [ClearLog], Source={x:Static loc:Loc.Instance}}" />
                        </Grid>
                        <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource LogBox}" MinHeight="110"
                                 Text="{Binding LogText, Mode=OneWay}" TextChanged="LogBox_TextChanged" />
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="{Binding [OutputFolder], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Text="{Binding OutputFolder}" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding UpdateToolsCommand}"
                            Margin="10,0,0,0" Content="{Binding [UpdateTools], Source={x:Static loc:Loc.Instance}}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}"
                            Margin="10,0,0,0" Content="{Binding [OpenFolder], Source={x:Static loc:Loc.Instance}}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
